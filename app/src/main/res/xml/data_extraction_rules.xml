<?xml version="1.0" encoding="utf-8"?>
<!-- Calibration/preferences are the only persistent user data. Recalibrate on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
